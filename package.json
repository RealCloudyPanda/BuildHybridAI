{
  "name": "repro-offline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rough QA notes in, reproducible bug report out. On your device, with Firebase AI Logic hybrid inference.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit -p . && vite build",
